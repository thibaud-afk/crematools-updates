<Window x:Class="CremaTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CrémaTools — CremaLab" Width="1220" Height="860" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E0E7F0" BorderThickness="0,0,1,0"><DockPanel Margin="22,28,18,22"><StackPanel DockPanel.Dock="Top"><Image Source="assets/logo.png" Width="175" HorizontalAlignment="Left"/><TextBlock Text="CrémaTools" FontSize="25" FontWeight="SemiBold" Margin="0,26,0,4"/><TextBlock Text="Le quotidien, en plus simple." Foreground="#718097" FontSize="12" Margin="0,0,0,26"/><Button Content="⌂   Tous mes outils" Click="HomeClick"/><Button Content="↘   Compresser" Click="CompressClick"/><Button Content="⇄   Convertir" Click="ConvertClick"/><Button Content="≡   Renommer et classer" Click="RenameClick"/><Button Content="▣   Scanner et lire le texte" Click="ScanClick"/><Button Content="▤   Mon coffre" Click="VaultClick"/></StackPanel><StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Button Content="↻   Mises à jour" Click="UpdatesClick"/><TextBlock Text="Offert avec plaisir par&#10;Thibaud CREMADES" FontSize="11" Foreground="#7D8CA0" Margin="4,15,0,0"/></StackPanel></DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Page" Margin="36,30,36,30"/></ScrollViewer>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#E0E7F0" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ProgressBar x:Name="Progress" Width="100" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="8,0"/><Button x:Name="CancelButton" Content="Annuler" Padding="12,4" Margin="4,5" Visibility="Collapsed" Click="CancelClick"/></StackPanel><TextBlock x:Name="Status" Text="Prêt. Choisissez un outil ou déposez vos fichiers." VerticalAlignment="Center" Foreground="#607087" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
